# --- Contacto / WhatsApp ---
# Número de WhatsApp en formato internacional, sin "+", sin espacios (ej: 51987654321)
PUBLIC_WHATSAPP_NUMBER=50684483410

# --- Contacto general ---
PUBLIC_CONTACT_EMAIL=info@flo-dev.com

# --- Formulario de contacto ---
# Endpoint al que se enviará el formulario (Formspree, Resend a través de una función serverless, n8n webhook, etc.)
# Debe tener el prefijo PUBLIC_ porque el formulario se envía desde el navegador (sitio estático).
PUBLIC_CONTACT_FORM_ENDPOINT=

# --- SEO / Analytics (opcional) ---
PUBLIC_SITE_URL=https://flo-de.com
PUBLIC_GA_ID=
