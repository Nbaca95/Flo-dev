---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import ProjectCard from '../../components/projects/ProjectCard.astro';
import Icon from '../../components/ui/Icon.astro';
import { getDictionary } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';
import { projects } from '../../data/projects';

interface Props {
  locale: Locale;
  route: string;
}
const { locale, route } = Astro.props;
const t = getDictionary(locale);
---

<BaseLayout locale={locale} route={route} title={t.nav.projects} description={t.projectsPage.subtitle}>
  <section class="pt-16 pb-6 sm:pt-20">
    <div class="container-flo">
      <SectionHeading eyebrow={t.projectsPage.eyebrow} title={t.projectsPage.title} subtitle={t.projectsPage.subtitle} />
    </div>
  </section>

  <section class="py-12 sm:py-16">
    <div class="container-flo">
      {projects.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {projects.map((project) => (
            <ProjectCard
              project={project}
              locale={locale}
              labels={{
                client: t.projectsPage.client,
                problem: t.projectsPage.problem,
                solution: t.projectsPage.solution,
                tech: t.projectsPage.tech,
                results: t.projectsPage.results,
              }}
            />
          ))}
        </div>
      ) : (
        <div class="mx-auto flex max-w-lg flex-col items-center rounded-[2rem] border border-dashed border-paper-border py-20 text-center dark:border-ink-border">
          <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-flo-gradient-soft text-accent-600 dark:text-accent-400">
            <Icon name="Rocket" class="h-6 w-6" />
          </div>
          <h3 class="mt-6 font-display text-xl font-semibold text-ink-900 dark:text-paper-100">
            {t.projectsPage.comingSoonTitle}
          </h3>
          <p class="mt-3 text-ink-700/70 dark:text-paper-200/60">{t.projectsPage.comingSoonText}</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
