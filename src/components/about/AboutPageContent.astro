---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import FounderSection from '../../components/about/FounderSection.astro';
import Icon from '../../components/ui/Icon.astro';
import { getDictionary } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';
import { personSchema } from '../../utils/schema';

interface Props {
  locale: Locale;
  route: string;
}
const { locale, route } = Astro.props;
const t = getDictionary(locale);
const jsonLd = [personSchema()];

const valueIcons = ['Sparkles', 'Check', 'Globe', 'Users', 'Workflow', 'Compass'];
---

<BaseLayout locale={locale} route={route} title={t.nav.about} description={t.aboutPage.intro} jsonLd={jsonLd}>
  <section class="pt-16 pb-6 sm:pt-20">
    <div class="container-flo">
      <SectionHeading eyebrow={t.aboutPage.eyebrow} title={t.aboutPage.title} subtitle={t.aboutPage.intro} />
    </div>
  </section>

  <section class="py-12">
    <div class="container-flo">
      <FounderSection locale={locale} roleLabel={t.aboutPage.founderRole} bio={t.aboutPage.founderBio} />
    </div>
  </section>

  <section class="py-12 sm:py-16">
    <div class="container-flo grid gap-6 sm:grid-cols-2">
      <div class="rounded-2xl border border-paper-border bg-paper-50 p-7 dark:border-ink-border dark:bg-ink-800">
        <h3 class="font-display text-lg font-semibold text-ink-900 dark:text-paper-100">{t.aboutPage.missionTitle}</h3>
        <p class="mt-3 leading-relaxed text-ink-700/75 dark:text-paper-200/65">{t.aboutPage.mission}</p>
      </div>
      <div class="rounded-2xl border border-paper-border bg-paper-50 p-7 dark:border-ink-border dark:bg-ink-800">
        <h3 class="font-display text-lg font-semibold text-ink-900 dark:text-paper-100">{t.aboutPage.visionTitle}</h3>
        <p class="mt-3 leading-relaxed text-ink-700/75 dark:text-paper-200/65">{t.aboutPage.vision}</p>
      </div>
    </div>
  </section>

  <section class="pb-24">
    <div class="container-flo">
      <h3 class="font-display text-lg font-semibold text-ink-900 dark:text-paper-100">{t.aboutPage.valuesTitle}</h3>
      <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {t.aboutPage.values.map((value, i) => (
          <div class="rounded-2xl border border-paper-border bg-paper-50 p-6 dark:border-ink-border dark:bg-ink-800">
            <div class="mb-4 flex h-9 w-9 items-center justify-center rounded-lg bg-flo-gradient-soft text-accent-600 dark:text-accent-400">
              <Icon name={valueIcons[i]} class="h-4 w-4" />
            </div>
            <h4 class="font-display text-sm font-semibold text-ink-900 dark:text-paper-100">{value.title}</h4>
            <p class="mt-1.5 text-sm leading-relaxed text-ink-700/70 dark:text-paper-200/60">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
