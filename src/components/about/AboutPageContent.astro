---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import FounderSection from '../../components/about/FounderSection.astro';
import PoliciesGrid from '../../components/about/PoliciesGrid.astro';
import { getDictionary } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';
import { personSchema } from '../../utils/schema';

interface Props {
  locale: Locale;
  route: string;
}
const { locale, route } = Astro.props;
const t = getDictionary(locale);
const jsonLd = [personSchema()];

const valueEmojis = ['💡', '✅', '🌐', '🤝', '🔄', '🎯'];
---

<BaseLayout locale={locale} route={route} title={t.nav.about} description={t.aboutPage.intro} jsonLd={jsonLd}>
  <section class="pt-16 pb-6 sm:pt-20">
    <div class="container-flo">
      <SectionHeading eyebrow={t.aboutPage.eyebrow} title={t.aboutPage.title} subtitle={t.aboutPage.intro} />
    </div>
  </section>

  <section class="py-12">
    <div class="container-flo">
      <FounderSection locale={locale} roleLabel={t.aboutPage.founderRole} bio={t.aboutPage.founderBio} />
    </div>
  </section>

  <section class="py-12 sm:py-16">
    <div class="container-flo grid gap-6 sm:grid-cols-2">
      <div class="group rounded-2xl border border-paper-border bg-paper-50 p-8 text-center transition-all duration-300 hover:-translate-y-2 hover:border-accent-500/40 hover:shadow-glow dark:border-ink-border dark:bg-ink-800">
        <div class="text-5xl transition-transform duration-300 group-hover:-rotate-6 group-hover:scale-110">🔍</div>
        <h3 class="mt-5 font-display text-lg font-semibold text-ink-900 transition-colors duration-300 group-hover:text-accent-600 dark:text-paper-100 dark:group-hover:text-accent-400">
          {t.aboutPage.missionTitle}
        </h3>
        <p class="mt-3 leading-relaxed text-ink-700/75 dark:text-paper-200/65">{t.aboutPage.mission}</p>
      </div>
      <div class="group rounded-2xl border border-paper-border bg-paper-50 p-8 text-center transition-all duration-300 hover:-translate-y-2 hover:border-accent-500/40 hover:shadow-glow dark:border-ink-border dark:bg-ink-800">
        <div class="text-5xl transition-transform duration-300 group-hover:-rotate-6 group-hover:scale-110">🚀</div>
        <h3 class="mt-5 font-display text-lg font-semibold text-ink-900 transition-colors duration-300 group-hover:text-accent-600 dark:text-paper-100 dark:group-hover:text-accent-400">
          {t.aboutPage.visionTitle}
        </h3>
        <p class="mt-3 leading-relaxed text-ink-700/75 dark:text-paper-200/65">{t.aboutPage.vision}</p>
      </div>
    </div>
  </section>

  <section class="relative overflow-hidden bg-ink-900 py-20 sm:py-24">
    <!-- Textura sutil tipo circuito, sin depender de una imagen -->
    <div
      class="pointer-events-none absolute inset-0 opacity-[0.07]"
      style="background-image: radial-gradient(currentColor 1px, transparent 1px); background-size: 26px 26px; color: #17B8C9;"
    ></div>
    <div class="pointer-events-none absolute -top-24 left-1/2 h-[420px] w-[420px] -translate-x-1/2 rounded-full bg-flo-gradient opacity-[0.12] blur-[110px]"></div>

    <div class="container-flo relative">
      <h3 class="text-center font-display text-3xl font-bold text-white sm:text-4xl">{t.aboutPage.valuesTitle}</h3>
      <p class="mx-auto mt-3 max-w-xl text-center text-paper-200/60">{t.aboutPage.valuesSubtitle}</p>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {t.aboutPage.values.map((value, i) => (
          <div class="group relative flex flex-col items-center overflow-hidden rounded-2xl border border-white/10 bg-ink-800/70 p-8 text-center backdrop-blur-sm transition-all duration-300 hover:-translate-y-2 hover:border-accent-500/50 hover:shadow-glow">
            <div class="text-5xl transition-transform duration-300 group-hover:-rotate-6 group-hover:scale-110">
              {valueEmojis[i]}
            </div>
            <h4 class="mt-5 font-display text-lg font-semibold text-white transition-colors duration-300 group-hover:text-accent-300">
              {value.title}
            </h4>
            <p class="mt-2 text-sm leading-relaxed text-paper-200/60">{value.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="pb-24">
    <div class="container-flo">
      <PoliciesGrid
        locale={locale}
        title={t.aboutPage.policiesTitle}
        subtitle={t.aboutPage.policiesSubtitle}
        comingSoonLabel={t.aboutPage.comingSoon}
      />
    </div>
  </section>
</BaseLayout>