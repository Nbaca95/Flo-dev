---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/ui/SectionHeading.astro';
import SolutionCard from '../../components/solutions/SolutionCard.astro';
import Button from '../../components/ui/Button.astro';
import { getDictionary } from '../../i18n/utils';
import { localePath, type Locale } from '../../i18n/config';

interface Props {
  locale: Locale;
  route: string;
}
const { locale, route } = Astro.props;
const t = getDictionary(locale);
const contactPath = localePath(locale, locale === 'en' ? 'contact' : 'contacto');
---

<BaseLayout locale={locale} route={route} title={t.nav.solutions} description={t.solutionsPage.subtitle}>
  <section class="pt-16 pb-6 sm:pt-20">
    <div class="container-flo">
      <SectionHeading eyebrow={t.solutionsPage.eyebrow} title={t.solutionsPage.title} subtitle={t.solutionsPage.subtitle} />
    </div>
  </section>

  <section class="py-12 sm:py-16">
    <div class="container-flo grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {t.solutionsPage.items.map((item) => (
        <SolutionCard
          problem={item.problem}
          solution={item.solution}
          description={item.description}
          solutionLabel={t.solutionsPage.solutionLabel}
        />
      ))}
    </div>
  </section>

  <section class="pb-24">
    <div class="container-flo">
      <div class="rounded-[2rem] border border-paper-border bg-paper-50 px-8 py-14 text-center dark:border-ink-border dark:bg-ink-800">
        <h2 class="text-2xl font-bold text-ink-900 dark:text-paper-100 sm:text-3xl">{t.solutionsPage.ctaTitle}</h2>
        <p class="mx-auto mt-3 max-w-md text-ink-700/70 dark:text-paper-200/60">{t.solutionsPage.ctaText}</p>
        <div class="mt-7">
          <Button href={contactPath} size="lg">{t.solutionsPage.ctaButton}</Button>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
