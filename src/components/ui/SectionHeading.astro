---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  class?: string;
}
const { eyebrow, title, subtitle, align = 'left', class: className = '' } = Astro.props;
const alignClass = align === 'center' ? 'text-center mx-auto' : 'text-left';
---

<div class={`max-w-2xl ${alignClass} ${className}`}>
  {eyebrow && (
    <p class="eyebrow mb-3 animate-fade-up">{eyebrow}</p>
  )}
  <h2 class="text-3xl font-bold leading-[1.1] text-ink-900 dark:text-paper-100 sm:text-4xl animate-fade-up [animation-delay:80ms]">
    {title}
  </h2>
  {subtitle && (
    <p class="mt-4 text-lg text-ink-700/80 dark:text-paper-200/70 animate-fade-up [animation-delay:160ms]">
      {subtitle}
    </p>
  )}
</div>
