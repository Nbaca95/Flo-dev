---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'ghost';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  type?: 'button' | 'submit';
  disabled?: boolean;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  class: className = '',
  type = 'button',
  disabled = false,
} = Astro.props;

const base =
  'inline-flex items-center justify-center gap-2 rounded-full font-display font-semibold transition-all duration-200 focus-visible:outline-none disabled:opacity-50 disabled:pointer-events-none';

const sizes = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-3 text-sm',
  lg: 'px-8 py-4 text-base',
};

const variants = {
  primary:
    'bg-flo-gradient text-white shadow-glow hover:brightness-110 hover:-translate-y-0.5 active:translate-y-0',
  secondary:
    'bg-ink-900 text-white hover:bg-ink-700 dark:bg-white dark:text-ink-900 dark:hover:bg-paper-200 hover:-translate-y-0.5',
  outline:
    'border border-paper-border text-ink-900 hover:border-accent-500 hover:text-accent-600 dark:border-ink-border dark:text-paper-100 dark:hover:border-accent-400 dark:hover:text-accent-400',
  ghost: 'text-ink-900 hover:bg-paper-200 dark:text-paper-100 dark:hover:bg-ink-700',
};

const classes = `${base} ${sizes[size]} ${variants[variant]} ${className}`;
const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  type={!href ? type : undefined}
  disabled={!href ? disabled : undefined}
  class={classes}
>
  <slot />
</Tag>
