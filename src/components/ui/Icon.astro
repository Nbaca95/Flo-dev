---
import { icons } from '../../utils/icons';

interface Props {
  name: keyof typeof icons | string;
  class?: string;
  strokeWidth?: number;
  id?: string;
}
const { name, class: className = 'h-5 w-5', strokeWidth = 1.75, id } = Astro.props;
const markup = icons[name] ?? '';
---

<svg
  id={id}
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={markup}
/>
