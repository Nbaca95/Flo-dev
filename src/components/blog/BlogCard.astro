---
import { blogCategoryLabels } from '../../data/blogCategories';
import type { Locale } from '../../i18n/config';

interface Props {
  href: string;
  title: string;
  description: string;
  category: string;
  locale: Locale;
  date: Date;
  readingMinutes: number;
  readingTimeLabel: string;
}
const { href, title, description, category, locale, date, readingMinutes, readingTimeLabel } = Astro.props;
const categoryLabel = blogCategoryLabels[category]?.[locale] ?? category;
const dateLabel = date.toLocaleDateString(locale === 'en' ? 'en-US' : 'es-ES', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a
  href={href}
  class="group flex flex-col rounded-2xl border border-paper-border bg-paper-50 p-6 transition-all duration-300 hover:-translate-y-1 hover:shadow-glow dark:border-ink-border dark:bg-ink-800"
>
  <span class="text-xs font-mono uppercase tracking-wider text-accent-600 dark:text-accent-400">{categoryLabel}</span>
  <h3 class="mt-3 font-display text-lg font-semibold text-ink-900 group-hover:text-accent-600 dark:text-paper-100 dark:group-hover:text-accent-400">
    {title}
  </h3>
  <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-700/75 dark:text-paper-200/65">{description}</p>
  <div class="mt-5 flex items-center gap-3 text-xs text-ink-700/50 dark:text-paper-200/40">
    <span>{dateLabel}</span>
    <span>·</span>
    <span>{readingMinutes} {readingTimeLabel}</span>
  </div>
</a>
