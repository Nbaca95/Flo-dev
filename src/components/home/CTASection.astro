---
import { getDictionary } from '../../i18n/utils';
import { localePath, type Locale } from '../../i18n/config';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDictionary(locale);
---

<section class="py-20 sm:py-28">
  <div class="container-flo">
    <div class="relative overflow-hidden rounded-[2rem] bg-ink-900 px-8 py-16 text-center sm:px-16 sm:py-20">
      <div class="pointer-events-none absolute inset-0 bg-flo-radial opacity-70"></div>
      <div class="relative">
        <h2 class="mx-auto max-w-2xl text-3xl font-bold leading-tight text-white sm:text-4xl">
          {t.ctaSection.title}
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-lg text-paper-200/70">{t.ctaSection.text}</p>
        <div class="mt-8">
          <Button href={localePath(locale, locale === 'en' ? 'contact' : 'contacto')} size="lg">
            {t.ctaSection.button}
            <Icon name="ArrowRight" class="h-4 w-4" />
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>
