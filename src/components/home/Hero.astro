---
import { getDictionary } from '../../i18n/utils';
import { localePath, type Locale } from '../../i18n/config';
import { company } from '../../data/company';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDictionary(locale);
---

<section class="relative isolate overflow-hidden bg-ink-900">
  {/* ---------- Mobile / tablet chico (< sm): foto arriba en flujo normal, texto abajo sobre fondo sólido ---------- */}
  <div class="sm:hidden">
    <div class="container-flo relative pt-8">
      <p class="eyebrow animate-fade-up !text-accent-300">{t.hero.eyebrow}</p>
      <h1 class="mt-4 text-3xl font-bold leading-[1.12] text-white animate-fade-up [animation-delay:120ms]">
        {t.hero.title}
      </h1>
      <p class="mt-5 text-base leading-relaxed text-paper-200/85 animate-fade-up [animation-delay:180ms]">
        {t.hero.text}
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4 animate-fade-up [animation-delay:240ms]">
        <Button href={localePath(locale, locale === 'en' ? 'contact' : 'contacto')} size="lg">
          {t.hero.ctaPrimary}
          <Icon name="ArrowRight" class="h-4 w-4" />
        </Button>
        <a
          href={localePath(locale, locale === 'en' ? 'services' : 'servicios')}
          class="inline-flex items-center justify-center gap-2 rounded-full border border-white/25 px-7 py-3.5 font-display text-sm font-semibold text-white transition-all duration-200 hover:-translate-y-0.5 hover:border-white/60"
        >
          {t.hero.ctaSecondary}
        </a>
      </div>
    </div>

    {/* Contenedor optimizado para móvil con plano más abierto */}
    <div class="relative mt-10 aspect-[4/5] w-full overflow-hidden">
      <img
        src={company.founder.photo}
        alt={company.founder.name}
        class="h-full w-full object-cover object-[50%_15%]"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-ink-900 via-ink-900/10 to-transparent"></div>
      <div class="absolute inset-x-4 bottom-4 inline-flex items-center rounded-full border border-white/10 bg-ink-900/55 px-4 py-2 backdrop-blur-md">
        <div class="leading-tight">
          <p class="text-sm font-semibold text-white">{company.founder.name}</p>
          <p class="font-mono text-[10px] uppercase tracking-[0.12em] text-accent-300">
            {company.founder.role[locale]}
          </p>
        </div>
      </div>
    </div>
  </div>

  {/* ---------- Desktop / tablet (sm y mayor): foto como franja de fondo a la derecha ---------- */}
  <div class="relative hidden min-h-[560px] sm:block lg:min-h-[680px]">
    <div class="absolute inset-y-0 right-0 w-4/5 md:w-3/5 lg:w-1/2 xl:w-[46%]">
      <img
        src={company.founder.photo}
        alt={company.founder.name}
        class="h-full w-full object-cover object-[65%_20%]"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-ink-900 via-ink-900/10 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-ink-900/70 via-transparent to-transparent"></div>

      <div class="absolute bottom-6 left-6 right-6 inline-flex w-fit rounded-full border border-white/10 bg-ink-900/45 px-5 py-2.5 backdrop-blur-md">
        <div class="leading-tight">
          <p class="text-sm font-semibold text-white">{company.founder.name}</p>
          <p class="font-mono text-[11px] uppercase tracking-[0.12em] text-accent-300">
            {company.founder.role[locale]}
          </p>
        </div>
      </div>
    </div>

    <div class="pointer-events-none absolute -top-32 left-[-10%] h-[520px] w-[520px] rounded-full bg-flo-gradient opacity-[0.12] blur-[120px]"></div>

    <div class="container-flo relative flex min-h-[560px] items-center py-16 lg:min-h-[680px]">
      <div class="max-w-xl">
        <p class="eyebrow animate-fade-up !text-accent-300">{t.hero.eyebrow}</p>
        <h1 class="mt-4 text-4xl font-bold leading-[1.08] text-white lg:text-[3.4rem] animate-fade-up [animation-delay:120ms]">
          {t.hero.title}
        </h1>
        <p class="mt-6 max-w-lg text-lg leading-relaxed text-paper-200/85 animate-fade-up [animation-delay:180ms]">
          {t.hero.text}
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-4 animate-fade-up [animation-delay:240ms]">
          <Button href={localePath(locale, locale === 'en' ? 'contact' : 'contacto')} size="lg">
            {t.hero.ctaPrimary}
            <Icon name="ArrowRight" class="h-4 w-4" />
          </Button>
          <a
            href={localePath(locale, locale === 'en' ? 'services' : 'servicios')}
            class="inline-flex items-center justify-center gap-2 rounded-full border border-white/25 px-8 py-4 font-display text-base font-semibold text-white transition-all duration-200 hover:-translate-y-0.5 hover:border-white/60"
          >
            {t.hero.ctaSecondary}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>