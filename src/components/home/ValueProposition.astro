---
import { getDictionary } from '../../i18n/utils';
import type { Locale } from '../../i18n/config';
import SectionHeading from '../ui/SectionHeading.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDictionary(locale);

const icons = ['PenTool', 'Code2', 'Workflow', 'LifeBuoy'];
---

<section class="border-t border-paper-border py-20 dark:border-ink-border sm:py-28">
  <div class="container-flo">
    <SectionHeading title={t.valueProposition.title} subtitle={t.valueProposition.subtitle} />

    <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {t.valueProposition.pillars.map((pillar, i) => (
        <div class="surface rounded-2xl p-6">
          <div class="mb-5 flex h-10 w-10 items-center justify-center rounded-xl bg-flo-gradient-soft text-accent-600 dark:text-accent-400">
            <Icon name={icons[i]} class="h-5 w-5" />
          </div>
          <h3 class="font-display text-base font-semibold text-ink-900 dark:text-paper-100">{pillar.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-700/75 dark:text-paper-200/65">{pillar.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
