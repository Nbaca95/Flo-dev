---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import { getDictionary } from '../i18n/utils';

const t = getDictionary('es');
---

<BaseLayout locale="es" route="404" title={t.common.notFoundTitle} noIndex>
  <section class="flex min-h-[60vh] flex-col items-center justify-center px-6 text-center">
    <p class="font-mono text-sm text-accent-600 dark:text-accent-400">404</p>
    <h1 class="mt-3 text-3xl font-bold text-ink-900 dark:text-paper-100">{t.common.notFoundTitle}</h1>
    <p class="mt-3 max-w-md text-ink-700/70 dark:text-paper-200/60">{t.common.notFoundText}</p>
    <div class="mt-8">
      <Button href="/">{t.common.goHome}</Button>
    </div>
  </section>
</BaseLayout>
