---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BlogCard from '../../../components/blog/BlogCard.astro';
import Icon from '../../../components/ui/Icon.astro';
import { getDictionary } from '../../../i18n/utils';
import { blogCategoryLabels, estimateReadingMinutes } from '../../../data/blogCategories';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.lang === 'en' && !data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}
const { post } = Astro.props;
const { Content } = await post.render();
const t = getDictionary('en');

const allPosts = await getCollection('blog', ({ data }) => data.lang === 'en' && !data.draft);
const related = allPosts
  .filter((p) => p.slug !== post.slug && p.data.category === post.data.category)
  .slice(0, 3);

const categoryLabel = blogCategoryLabels[post.data.category]?.en ?? post.data.category;
const dateLabel = post.data.publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout locale="en" route={`blog/${post.slug}`} title={post.data.title} description={post.data.description}>
  <article class="pt-16 pb-20 sm:pt-20">
    <div class="container-flo max-w-3xl">
      <a href="/en/blog" class="inline-flex items-center gap-1.5 text-sm text-ink-700/60 hover:text-accent-600 dark:text-paper-200/50 dark:hover:text-accent-400">
        <Icon name="ArrowRight" class="h-4 w-4 rotate-180" />
        {t.blogPage.backToBlog}
      </a>

      <span class="mt-6 block text-xs font-mono uppercase tracking-wider text-accent-600 dark:text-accent-400">
        {categoryLabel}
      </span>
      <h1 class="mt-3 text-3xl font-bold leading-tight text-ink-900 dark:text-paper-100 sm:text-4xl">
        {post.data.title}
      </h1>
      <div class="mt-4 flex items-center gap-3 text-sm text-ink-700/50 dark:text-paper-200/40">
        <span>{dateLabel}</span>
        <span>·</span>
        <span>{estimateReadingMinutes(post.body)} {t.blogPage.readingTime}</span>
      </div>

      <div class="prose prose-neutral mt-10 max-w-none dark:prose-invert prose-headings:font-display prose-a:text-accent-600 dark:prose-a:text-accent-400">
        <Content />
      </div>

      {related.length > 0 && (
        <div class="mt-16 border-t border-paper-border pt-10 dark:border-ink-border">
          <h2 class="font-display text-lg font-semibold text-ink-900 dark:text-paper-100">{t.blogPage.relatedTitle}</h2>
          <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((r) => (
              <BlogCard
                href={`/en/blog/${r.slug}`}
                title={r.data.title}
                description={r.data.description}
                category={r.data.category}
                locale="en"
                date={r.data.publishDate}
                readingMinutes={estimateReadingMinutes(r.body)}
                readingTimeLabel={t.blogPage.readingTime}
              />
            ))}
          </div>
        </div>
      )}
    </div>
  </article>
</BaseLayout>
